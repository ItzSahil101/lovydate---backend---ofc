PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lovydate
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=10000

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_DAYS=30

# CORS
CORS_ORIGIN=*
LOG_LEVEL=info

# SMTP Email
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM="LovyDate <no-reply@lovydate.com>"

# S3 / Cloudflare R2 Media Storage
S3_ENDPOINT=
S3_BUCKET=lovydate-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# Firebase Cloud Messaging (FCM) Push Notifications
# Option 1: Paste the one-line JSON string of your service account key
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project-id",...}'
# Option 2: Point to the local serviceAccountKey.json file
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
