{
  "name": "lovydate-backend",
  "version": "1.0.0",
  "description": "LovyDate High-Performance Production Backend",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node src/infrastructure/database/migrate.js",
    "clean": "node src/infrastructure/database/clean_db.js",
    "clean:s3": "node src/infrastructure/s3/clear_s3.js",
    "seed": "node src/infrastructure/database/seed_profiles.js",
    "test": "jest tests/unit.test.js --forceExit",
    "test:e2e": "jest tests/*.test.js --runInBand --detectOpenHandles --forceExit",
    "transfer:s3": "node src/infrastructure/s3/migrate_uploads_to_s3.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.41.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^14.3.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.5.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.1.0",
    "pg": "^8.13.3",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  }
}
